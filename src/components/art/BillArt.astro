---
/**
 * Decorative miniature of the Bill of Supply tool: the form on the left, the
 * finished A4 document on the right. Both blocks are centred on y = 116 and sit
 * 20 px from either edge of the 360 × 232 box, so the illustration fills the same
 * frame as the die-line artwork and stays optically symmetric.
 */
interface Props {
	class?: string;
	animate?: boolean;
}
const { class: className = '', animate = false } = Astro.props;
---

<svg
	viewBox="0 0 360 232"
	class={className}
	role="img"
	aria-label="Illustration of the Bill of Supply form and the PDF document it generates"
	data-animate={animate ? '' : undefined}
>
	<!-- Form -->
	<g class="form">
		<rect x="20" y="26" width="140" height="180" rx="8" fill="#ffffff" stroke="#e5e5ea"></rect>
		<rect x="32" y="40" width="56" height="6" rx="2" fill="#1d1d1f"></rect>

		<rect x="32" y="58" width="30" height="3.5" rx="1.75" fill="#c7c7cc"></rect>
		<rect x="32" y="66" width="116" height="14" rx="4" fill="#fafafc" stroke="#e5e5ea"></rect>

		<rect x="32" y="90" width="24" height="3.5" rx="1.75" fill="#c7c7cc"></rect>
		<rect x="32" y="98" width="116" height="14" rx="4" fill="#fafafc" stroke="#e5e5ea"></rect>

		<rect x="32" y="122" width="20" height="3.5" rx="1.75" fill="#c7c7cc"></rect>
		<rect x="32" y="130" width="55" height="14" rx="4" fill="#fafafc" stroke="#e5e5ea"></rect>
		<rect x="93" y="130" width="55" height="14" rx="4" fill="#fafafc" stroke="#e5e5ea"></rect>

		<g class="cta">
			<rect x="32" y="164" width="116" height="22" rx="11" fill="#0066cc"></rect>
			<text
				x="90"
				y="178.5"
				text-anchor="middle"
				font-family="Inter Variable, Inter, system-ui, sans-serif"
				font-size="9"
				font-weight="600"
				fill="#ffffff"
				letter-spacing="0.3">Download PDF</text
			>
		</g>
	</g>

	<!-- Document -->
	<rect x="187" y="19" width="156" height="204" rx="7" fill="#1d1d1f" opacity="0.05"></rect>
	<rect x="184" y="14" width="156" height="204" rx="7" fill="#ffffff" stroke="#d8d8dd"></rect>

	<g class="ink">
		<!-- Supplier block (left) and document label (right) on one baseline grid -->
		<rect x="198" y="30" width="54" height="8" rx="2" fill="#1d1d1f"></rect>
		<rect x="198" y="44" width="76" height="4" rx="2" fill="#c7c7cc"></rect>
		<rect x="198" y="52" width="60" height="4" rx="2" fill="#c7c7cc"></rect>
		<rect x="282" y="29" width="44" height="6" rx="2" fill="#0066cc"></rect>
		<rect x="294" y="41" width="32" height="4" rx="2" fill="#c7c7cc"></rect>

		<rect x="198" y="64" width="128" height="1" fill="#e5e5ea"></rect>

		<!-- Billed to -->
		<rect x="198" y="74" width="24" height="4" rx="2" fill="#86868b"></rect>
		<rect x="198" y="82" width="58" height="4" rx="2" fill="#c7c7cc"></rect>
		<rect x="198" y="90" width="46" height="4" rx="2" fill="#c7c7cc"></rect>

		<!-- Line items: descriptions left, amounts right-aligned to one edge -->
		<rect x="198" y="104" width="128" height="11" rx="2" fill="#f5f5f7"></rect>
		<g fill="#c7c7cc">
			<rect x="204" y="123" width="62" height="4" rx="2"></rect>
			<rect x="292" y="123" width="28" height="4" rx="2"></rect>
			<rect x="204" y="135" width="50" height="4" rx="2"></rect>
			<rect x="292" y="135" width="28" height="4" rx="2"></rect>
			<rect x="204" y="147" width="68" height="4" rx="2"></rect>
			<rect x="292" y="147" width="28" height="4" rx="2"></rect>
		</g>

		<rect x="198" y="160" width="128" height="1" fill="#e5e5ea"></rect>

		<!-- Total -->
		<rect x="250" y="169" width="30" height="5" rx="2" fill="#86868b"></rect>
		<rect x="286" y="167" width="40" height="8" rx="2" fill="#1d1d1f"></rect>

		<!-- Amount in words -->
		<rect x="198" y="184" width="96" height="4" rx="2" fill="#c7c7cc"></rect>
	</g>

	<!-- Signature -->
	<g class="sign">
		<path
			d="M276 202c5-8 8 3 13-4s6 5 11-2"
			fill="none"
			stroke="#1d1d1f"
			stroke-width="1.4"
			stroke-linecap="round"
			opacity="0.7"
			pathLength="1"></path>
		<rect x="274" y="207" width="52" height="1" fill="#e5e5ea"></rect>
		<rect x="286" y="211" width="28" height="3" rx="1.5" fill="#c7c7cc"></rect>
	</g>
</svg>

<style>
	svg[data-animate] .form {
		animation: var(--animate-fade-in);
	}
	svg[data-animate] .cta {
		animation: var(--animate-fade-in);
		animation-delay: 0.45s;
	}
	svg[data-animate] .ink {
		animation: var(--animate-fade-in);
		animation-delay: 0.75s;
	}
	svg[data-animate] .sign path {
		stroke-dasharray: 1;
		animation: var(--animate-draw);
		animation-delay: 1.1s;
	}
	svg[data-animate] .sign rect {
		animation: var(--animate-fade-in);
		animation-delay: 1.6s;
	}
</style>
