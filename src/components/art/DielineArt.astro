---
/**
 * Decorative miniature of a gusseted paper-bag die-line (front · gusset · back · gusset · glue flap).
 * Colours follow print conventions: magenta = cut, green = fold, blue = bleed.
 */
interface Props {
	class?: string;
	animate?: boolean;
}
const { class: className = '', animate = false } = Astro.props;
---

<svg
	viewBox="0 0 360 232"
	class={className}
	role="img"
	aria-label="Illustration of a paper bag die-line with cut, fold and bleed lines"
	data-animate={animate ? '' : undefined}
>
	<rect x="18" y="18" width="324" height="196" rx="4" fill="#ffffff" stroke="#e5e5ea"></rect>
	<!-- bleed -->
	<rect x="30" y="34" width="292" height="164" fill="none" stroke="#0a84ff" stroke-width="1" stroke-dasharray="3 2.5" opacity="0.8"></rect>
	<!-- cut outline -->
	<path
		class="cut"
		d="M38 42h256l6 5v146l-6 5H38z"
		fill="none"
		stroke="#e10098"
		stroke-width="1.8"
		stroke-linejoin="round"
		pathLength="1"></path>
	<!-- vertical folds -->
	<g class="fold" fill="none" stroke="#16a34a" stroke-width="1.2" stroke-dasharray="4 3">
		<path d="M112 42v156M156 42v156M230 42v156M274 42v156"></path>
	</g>
	<g class="fold" fill="none" stroke="#16a34a" stroke-width="1" stroke-dasharray="1.5 2.5">
		<path d="M134 42v156M252 42v156"></path>
	</g>
	<!-- top hem + bottom fold -->
	<g class="fold" fill="none" stroke="#16a34a" stroke-width="1.2" stroke-dasharray="4 3">
		<path d="M38 66h256M38 152h256M38 174h256"></path>
	</g>
	<!-- bottom diamonds -->
	<g class="fold" fill="none" stroke="#16a34a" stroke-width="1.1" stroke-dasharray="3 2">
		<path d="M112 152l22 22 22-22M230 152l22 22 22-22"></path>
	</g>
	<!-- eyelets -->
	<g class="fold" fill="none" stroke="#e10098" stroke-width="1.2">
		<circle cx="56" cy="54" r="3.5"></circle>
		<circle cx="94" cy="54" r="3.5"></circle>
		<circle cx="174" cy="54" r="3.5"></circle>
		<circle cx="212" cy="54" r="3.5"></circle>
	</g>
	<!-- labels -->
	<g class="fold" font-family="Inter Variable, Inter, system-ui, sans-serif" font-size="8" fill="#86868b" text-anchor="middle" letter-spacing="0.6">
		<text x="75" y="113">FRONT</text>
		<text x="134" y="113">GUSSET</text>
		<text x="193" y="113">BACK</text>
		<text x="252" y="113">GUSSET</text>
		<text x="284" y="113" font-size="6.5">GLUE</text>
	</g>
</svg>

<style>
	svg[data-animate] .cut {
		stroke-dasharray: 1;
		animation: var(--animate-draw);
	}
	svg[data-animate] .fold {
		animation: var(--animate-fade-in);
		animation-delay: 0.9s;
	}
	svg[data-animate] rect:nth-of-type(2) {
		animation: var(--animate-fade-in);
		animation-delay: 1.2s;
	}
</style>
