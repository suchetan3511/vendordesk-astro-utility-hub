---
import type { ToolMeta } from '../lib/site';

interface Props {
	tool: ToolMeta;
	index: number;
}
const { tool, index } = Astro.props;
---

{/*
	Spacing lives on the children as margins rather than a flex `gap`, so the stacked
	(mobile) and subgrid (desktop) layouts share one vertical rhythm. On md+ the card
	spans the six rows of the parent grid, which lines every card's artwork, heading,
	description, chips and footer up with its neighbour's.
*/}
<a
	href={tool.href}
	class="card group relative flex flex-col p-6 transition-[border-color,transform] duration-300 ease-(--ease-out-quart) hover:-translate-y-0.5 hover:border-hairline-strong active:scale-[0.99] sm:p-8 md:row-span-6 md:grid md:grid-rows-subgrid"
>
	<div class="flex items-start justify-between gap-4">
		<span class="chip">{tool.category}</span>
		<span class="tnum text-fine text-ink-3">0{index + 1}</span>
	</div>

	<div class="mt-6 grid aspect-[16/10] place-items-center overflow-hidden rounded-md border border-hairline bg-parchment">
		<slot name="art" />
	</div>

	<h3 class="mt-6 text-title text-ink">{tool.name}</h3>
	<p class="mt-2 text-body text-ink-2">{tool.description}</p>

	<ul class="mt-5 flex flex-wrap gap-2" aria-label="Highlights">
		{tool.features.map((f) => <li class="chip">{f}</li>)}
	</ul>

	<div class="mt-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-caption">
		<span class="text-ink-3">{tool.audience}</span>
		<span class="inline-flex shrink-0 items-center gap-1.5 font-semibold text-primary">
			Open tool
			<svg
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				class="transition-transform duration-300 ease-(--ease-out-quart) group-hover:translate-x-0.5"
			>
				<path d="M5 12h14M13 6l6 6-6 6"></path>
			</svg>
		</span>
	</div>
</a>
