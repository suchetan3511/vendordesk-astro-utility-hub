---
import Logo from './Logo.astro';
import { BILL, NAV, SITE } from '../lib/site';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header
	class="sticky top-0 z-50 border-b border-hairline bg-parchment/80 backdrop-blur-xl backdrop-saturate-150"
	data-header
>
	<div class="relative mx-auto flex h-14 max-w-page items-center justify-between gap-4 px-5 sm:px-8">
		<a href="/" class="press -mx-2 flex min-h-11 items-center gap-2.5 rounded-full px-2" aria-label={`${SITE.name} home`}>
			<Logo />
			<span class="text-[17px] font-semibold tracking-[-0.02em] text-ink" translate="no">{SITE.name}</span>
		</a>

		<nav aria-label="Primary" class="hidden md:block">
			<ul class="flex items-center gap-1">
				{
					NAV.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={current === item.href ? 'page' : undefined}
								class="inline-flex min-h-9 items-center rounded-full border border-transparent px-3.5 text-caption whitespace-nowrap text-ink-2 transition-colors hover:text-ink aria-[current=page]:border-hairline aria-[current=page]:bg-surface aria-[current=page]:text-ink"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-1.5">
			<button
				type="button"
				data-theme-toggle
				class="press inline-flex size-11 items-center justify-center rounded-full text-ink-2 transition-colors hover:bg-surface hover:text-ink"
				aria-label="Switch to dark mode"
			>
				<svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"></path>
				</svg>
				<svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
				</svg>
			</button>

			{/* Held back to lg: at md the four nav labels plus a button leave no room and the nav wraps. */}
			<a href={BILL.href} class="btn btn-primary btn-sm hidden lg:inline-flex">Create a bill</a>

			<button
				type="button"
				data-menu-toggle
				class="press inline-flex size-11 items-center justify-center rounded-full text-ink transition-colors hover:bg-surface md:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Open menu"
			>
				<svg data-icon="open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
				<svg data-icon="close" hidden width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6 6 18"></path>
				</svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" hidden class="absolute inset-x-0 top-full border-b border-hairline bg-parchment/95 backdrop-blur-xl md:hidden">
		<nav aria-label="Mobile" class="mx-auto max-w-page px-5 pt-1 pb-5 sm:px-8">
			<ul class="flex flex-col">
				{
					NAV.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={current === item.href ? 'page' : undefined}
								class="flex min-h-13 items-center justify-between gap-4 border-b border-hairline text-body font-semibold text-ink aria-[current=page]:text-primary"
							>
								{item.label}
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-ink-3">
									<path d="M9 6l6 6-6 6"></path>
								</svg>
							</a>
						</li>
					))
				}
			</ul>
			<a href={BILL.href} class="btn btn-primary mt-4 w-full">Create a bill</a>
		</nav>
	</div>
</header>

<script>
	const KEY = 'vd-theme';
	const root = document.documentElement;
	const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

	function applyTheme(theme: 'light' | 'dark') {
		root.setAttribute('data-theme', theme);
		if (meta) meta.setAttribute('content', meta.dataset[theme] ?? '');
		toggles.forEach((btn) => btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'));
	}

	applyTheme(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

	toggles.forEach((btn) =>
		btn.addEventListener('click', () => {
			const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			try {
				localStorage.setItem(KEY, next);
			} catch {}
			applyTheme(next);
		}),
	);

	window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
		try {
			if (localStorage.getItem(KEY)) return;
		} catch {}
		applyTheme(e.matches ? 'dark' : 'light');
	});

	const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.getElementById('mobile-menu');
	if (menuBtn && menu) {
		const iconOpen = menuBtn.querySelector<SVGElement>('[data-icon="open"]');
		const iconClose = menuBtn.querySelector<SVGElement>('[data-icon="close"]');
		const setOpen = (open: boolean) => {
			menu.hidden = !open;
			menuBtn.setAttribute('aria-expanded', String(open));
			menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			if (iconOpen) iconOpen.hidden = open;
			if (iconClose) iconClose.hidden = !open;
		};
		menuBtn.addEventListener('click', () => setOpen(menu.hidden));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !menu.hidden) {
				setOpen(false);
				menuBtn.focus();
			}
		});
		window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
			if (e.matches) setOpen(false);
		});
	}
</script>
