---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../lib/site';
import { breadcrumb, webPage } from '../lib/schema';

const title = 'Contact';
const description = `Contact VendorDesk by email at ${SITE.email} — tool requests, corrections, bug reports, partnership or press enquiries.`;

const schema = [
	webPage({ name: `${title} · ${SITE.name}`, path: '/contact', description, type: 'ContactPage', hasBreadcrumb: true }),
	breadcrumb([
		{ name: 'Home', path: '/' },
		{ name: 'Contact', path: '/contact' },
	]),
];
---

<Layout title={title} description={description} schema={schema}>
	<PageHeader
		eyebrow="Contact"
		title="Say hello."
		lead="Found a bug, need a correction, or have a calculation you wish existed as a tool? Email is the only way to reach us — there is no form, no chat widget and no phone queue."
		crumbs={[{ name: 'Home', href: '/' }, { name: 'Contact' }]}
	/>

	<section class="bg-parchment">
		<div class="mx-auto max-w-narrow px-5 py-12 sm:px-8 sm:py-16">
			<div class="card p-6 text-center sm:p-10">
				<p class="eyebrow">Email us</p>
				<a href={`mailto:${SITE.email}`} class="mt-3 block text-title break-all text-primary">{SITE.email}</a>
				<div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
					<a href={`mailto:${SITE.email}`} class="btn btn-primary w-full sm:w-auto">Open in my email app</a>
					<button type="button" data-copy-email data-email={SITE.email} class="btn btn-ghost w-full sm:w-auto" aria-describedby="copy-status">
						Copy address
					</button>
				</div>
				<p id="copy-status" class="mt-3 text-fine text-ink-2" role="status" aria-live="polite"></p>
				<p class="mt-6 text-caption text-ink-2">We usually reply within a couple of business days (IST).</p>
			</div>

			<div class="card mt-4 p-6 text-caption text-ink-2 sm:p-8">
				<p class="font-semibold text-ink">What helps us help you</p>
				<ul class="mt-3 grid list-disc gap-2 pl-5">
					<li>The tool and the inputs you used</li>
					<li>What you expected vs. what happened</li>
					<li>Your browser and device</li>
					<li>For tool requests: the calculation or document, and who uses it</li>
				</ul>
			</div>

			<p class="mt-8 text-center text-caption text-ink-2">
				Looking for how we handle your data? Read the <a href="/privacy-policy" class="link">privacy policy</a> or the
				<a href="/terms-of-service" class="link">terms of service</a>.
			</p>
		</div>
	</section>
</Layout>

<script>
	const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
	const status = document.getElementById('copy-status');
	btn?.addEventListener('click', async () => {
		const email = btn.dataset.email ?? '';
		try {
			await navigator.clipboard.writeText(email);
			if (status) status.textContent = 'Copied to clipboard.';
		} catch {
			if (status) status.textContent = 'Copy failed — select the address and copy it manually.';
		}
	});
</script>
