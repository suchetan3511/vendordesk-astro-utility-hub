---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolCardCompact from '../components/ToolCardCompact.astro';
import Faq from '../components/Faq.astro';
import DielineArt from '../components/art/DielineArt.astro';
import BillArt from '../components/art/BillArt.astro';
import {
	ARTICLES,
	BILL,
	BOL,
	DIELINE,
	DIM_WEIGHT,
	FREIGHT_CHART,
	FREIGHT_CLASS,
	GROUP_LABELS,
	NMFC_LOOKUP,
	PURCHASE_ORDER,
	SITE,
	TOOLS,
} from '../lib/site';
import { itemList, webPage } from '../lib/schema';

const title = 'VendorDesk — Free Shipping & Business Document Tools';
const description = SITE.description;

const principles = [
	{
		n: '01',
		title: 'Nothing leaves your browser',
		body: 'Every calculation, SVG and PDF is produced by JavaScript on your device. There is no upload, no account and no server that ever sees your dimensions, clients or amounts.',
	},
	{
		n: '02',
		title: 'Loads before you finish reading this',
		body: 'Pages ship as static HTML and CSS. The only script that runs is the tool you are using — no frameworks, no chat widgets, no cookie walls slowing you down.',
	},
	{
		n: '03',
		title: 'Current, and honest about it',
		body: 'The freight tools use the NMFC density scale as restructured in July 2025 and the parcel rounding rules as they stand now. Where a figure is indicative rather than binding, the page says so.',
	},
];

const steps = [
	{ title: 'Type your details', body: 'Dimensions and weight, bill lines or bag measurements — a handful of fields with sensible defaults.' },
	{ title: 'Watch it update live', body: 'The class, the document and the die-line preview redraw as you type. No “calculate” button, no page reloads.' },
	{ title: 'Copy it or download it', body: 'A one-line summary for the bill of lading, an A4 PDF for the bill, real-scale SVG for the die-line.' },
];

const audiences = [
	{ title: 'Shippers & ecommerce sellers', body: 'Freight class before you book, and billable weight before the invoice surprises you.' },
	{ title: 'Freight brokers & 3PLs', body: 'A fast density check, a commodity reference, and a bill of lading you can hand to the driver.' },
	{ title: 'Buyers & operations teams', body: 'A purchase order your vendor can work from and your AP team can match an invoice against.' },
	{ title: 'Freelancers & small businesses', body: 'A clean Bill of Supply when you are below the GST threshold or under composition.' },
	{ title: 'Designers & packaging makers', body: 'Structural templates at 1:1 scale, ready for Illustrator, Affinity or Inkscape.' },
];

const faqs = [
	{
		question: 'Is VendorDesk really free?',
		answer:
			'Yes. Every tool on this site is free to use with no account, no watermark and no download limit. We may show unobtrusive advertising to keep the lights on.',
	},
	{
		question: 'Which freight tools are here?',
		answer:
			'A <a href="/freight-class-calculator">freight class calculator</a> that returns density and the NMFC class, the <a href="/freight-class-chart">full freight class chart</a>, an <a href="/nmfc-code-lookup">NMFC code lookup</a> for common commodities, and a <a href="/dimensional-weight-calculator">dimensional weight calculator</a> for UPS, FedEx and USPS parcels. If you are new to classification, start with <a href="/what-is-freight-class">what freight class is</a>.',
	},
	{
		question: 'Which document generators are here?',
		answer:
			'A <a href="/bill-of-lading-generator">bill of lading generator</a> for LTL shipments and a <a href="/purchase-order-generator">purchase order generator</a> for procurement, both producing a PDF built on your device. There is also a <a href="/unregistered-vendor-bill-of-supply">GST bill of supply generator</a> and a <a href="/paper-bag-die-line-generator">paper bag dieline generator</a> for businesses in India.',
	},
	{
		question: 'Are the freight figures up to date?',
		answer:
			'The freight class tools use the NMFC density provision as restructured by the NMFTA in Docket 2025-1, effective 19 July 2025 — thirteen subprovisions rather than the older eleven. The parcel calculator applies the whole-inch round-up that UPS, FedEx and USPS all now use, and the USPS one-cubic-foot threshold introduced in July 2026. Classification is ultimately your carrier’s call, so confirm before booking.',
	},
	{
		question: 'Do you store what I type into a tool?',
		answer:
			'No. The tools run entirely in your browser. Some tools can remember your last inputs in your own browser’s local storage so you can continue later — that data stays on your device and you can clear it at any time. Read the <a href="/privacy-policy">privacy policy</a>.',
	},
	{
		question: 'Can I rely on the outputs for production, filing or booking?',
		answer:
			'The tools are precise, but they are estimation and layout aids. Confirm freight classification with your carrier, proof a physical packaging mock-up, and check tax documents with your accountant. See the <a href="/terms-of-service">terms of service</a>.',
	},
	{
		question: 'Will there be more tools?',
		answer:
			'That is the plan. VendorDesk exists to replace bloated, gated SaaS calculators with fast single-purpose utilities. <a href="/contact">Tell us</a> which task wastes your time and we will look at building it.',
	},
];

const schema = [
	webPage({
		name: title,
		path: '/',
		description,
		type: 'CollectionPage',
		mainEntity: `${SITE.url}/#tools`,
	}),
	itemList({
		path: '/',
		name: 'Free VendorDesk tools',
		items: TOOLS.map((t) => ({ name: t.name, path: t.href, description: t.description })),
	}),
];

const shippingExtras = [FREIGHT_CHART, NMFC_LOOKUP];
---

<Layout title={title} description={description} schema={schema} titleTemplate={false}>
	<!-- Hero -->
	<section class="relative overflow-hidden bg-canvas">
		<div class="mx-auto grid max-w-page items-center gap-12 px-5 pt-14 pb-16 sm:px-8 sm:pt-20 sm:pb-24 lg:grid-cols-[1.2fr_1fr] lg:gap-14 lg:pt-24 lg:pb-28">
			{/* `min-w-0` lets these grid items shrink below their content's intrinsic width —
			    without it the illustration's intrinsic size sets a floor that overflows narrow phones. */}
			<div class="min-w-0 max-w-2xl">
				<p class="eyebrow animate-fade-up">Free · No sign-up · Runs entirely in your browser</p>
				<h1 class="mt-4 text-hero text-ink animate-fade-up" style="animation-delay: 80ms">
					Lightning‑fast shipping and business document tools.
				</h1>
				<p class="mt-6 max-w-xl text-lead text-ink-2 animate-fade-up" style="animation-delay: 160ms">
					Work out an <strong class="font-semibold text-ink">LTL freight class</strong> or a
					<strong class="font-semibold text-ink">parcel&rsquo;s billable weight</strong> in seconds, then generate the paperwork that
					goes with it — a bill of lading or a purchase order. Type your numbers, take the answer, get on with your day.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center animate-fade-up" style="animation-delay: 240ms">
					<a href={FREIGHT_CLASS.href} class="btn btn-primary btn-lg">Calculate freight class</a>
					<a href={DIM_WEIGHT.href} class="btn btn-secondary btn-lg">Calculate DIM weight</a>
				</div>
				<ul class="mt-8 grid max-w-md grid-cols-2 gap-x-6 gap-y-2.5 text-caption text-ink-2 animate-fade-up" style="animation-delay: 320ms">
					{
						['No account', 'Nothing uploaded', '2025 NMFC scale', 'Light & dark mode'].map((item) => (
							<li class="flex items-center gap-2">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-success">
									<path d="M5 12.5l4.5 4.5L19 7.5" />
								</svg>
								{item}
							</li>
						))
					}
				</ul>
			</div>

			{/* A static mock of the calculator's result panel: it advertises the flagship tool far
			    more directly than a decorative illustration, and costs nothing extra to ship. */}
			<div class="relative min-w-0 animate-fade-up" style="animation-delay: 200ms" aria-hidden="true">
				<div class="relative rounded-xl border border-hairline bg-surface p-4 sm:p-8">
					<div class="rounded-lg bg-parchment p-5 sm:p-6">
						<p class="eyebrow">Your freight class</p>
						<div class="mt-3 flex flex-wrap items-end gap-x-4 gap-y-1">
							<p class="tnum text-[clamp(3rem,9vw,4.5rem)] leading-[0.9] font-semibold tracking-[-0.03em] text-ink">85</p>
							<p class="text-caption text-ink-2">
								Density <span class="tnum font-semibold text-ink">12.7</span> lb/ft³<br />
								Sub <span class="tnum font-semibold text-ink">8</span> · 12 but less than 15
							</p>
						</div>
						<dl class="tnum mt-5 grid grid-cols-2 gap-x-5 gap-y-2.5 border-t border-hairline pt-4 text-caption">
							<div>
								<dt class="text-fine text-ink-2">Cubic feet</dt>
								<dd class="font-semibold text-ink">66.7 ft³</dd>
							</div>
							<div>
								<dt class="text-fine text-ink-2">Shipment</dt>
								<dd class="font-semibold text-ink">850 lb · 1 pallet</dd>
							</div>
						</dl>
					</div>
					<div class="pointer-events-none absolute top-6 left-6 hidden rounded-full border border-hairline bg-surface px-3 py-1.5 text-fine font-semibold text-ink-2 sm:block">
						48 × 40 × 60 in
					</div>
					<div class="pointer-events-none absolute right-6 bottom-6 hidden rounded-full bg-primary px-3 py-1.5 text-fine font-semibold text-on-primary sm:block">
						2025 NMFC scale
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Tools -->
	<section id="tools" class="border-y border-hairline bg-parchment" aria-labelledby="tools-heading">
		<div class="mx-auto max-w-page px-5 py-16 sm:px-8 sm:py-24">
			<div class="max-w-2xl">
				<p class="eyebrow">The tools</p>
				<h2 id="tools-heading" class="mt-3 text-display text-ink">Free shipping calculators and document generators</h2>
				<p class="mt-4 text-lead text-ink-2">
					Each one replaces a bloated SaaS sign-up flow with a page that is ready the moment it loads — no account, no watermark,
					no limit on downloads.
				</p>
			</div>

			<!-- Shipping & Freight -->
			<div class="mt-12">
				<h3 class="text-title text-ink">{GROUP_LABELS.shipping}</h3>
				<p class="mt-2 max-w-prose text-body text-ink-2">
					Classification and weight, for pallets and parcels. Built on the current NMFC density scale and the carrier rounding
					rules as they stand today.
				</p>
				<div class="mt-6 grid gap-4 md:grid-cols-2 md:gap-x-6">
					{/* The flagship spans the row; everything else sits in the two-column grid below it. */}
					<div class="md:col-span-2">
						<ToolCardCompact tool={FREIGHT_CLASS} featured />
					</div>
					<ToolCardCompact tool={DIM_WEIGHT} />
					{shippingExtras.map((tool) => <ToolCardCompact tool={tool} />)}
					{ARTICLES.map((a) => <ToolCardCompact tool={a} kind="article" />)}
				</div>
			</div>

			<!-- Business Documents -->
			<div class="mt-16">
				<h3 class="text-title text-ink">{GROUP_LABELS.documents}</h3>
				<p class="mt-2 max-w-prose text-body text-ink-2">
					Paperwork that usually costs a subscription. The bill of lading picks up where the freight class calculator leaves
					off — the class you worked out lands straight on the document.
				</p>
				<div class="mt-6 grid gap-4 md:grid-cols-2 md:gap-x-6">
					<ToolCardCompact tool={BOL} />
					<ToolCardCompact tool={PURCHASE_ORDER} />
				</div>

				{/* The Indian tools are a different market, not a different quality tier: labelled so a
				    US visitor can skip them and an Indian visitor can find them. */}
				<div class="mt-14">
					<h4 class="text-[1.0625rem] font-semibold text-ink">For businesses in India</h4>
					<p class="mt-2 max-w-prose text-body text-ink-2">
						GST-compliant billing for sellers below the threshold or under composition, and a print-ready packaging dieline.
					</p>
					<div class="mt-6 grid gap-5 md:grid-cols-2 md:grid-rows-[repeat(6,auto)] md:gap-x-6 md:gap-y-0">
						<ToolCard tool={BILL} index={0}>
							<BillArt slot="art" class="h-auto w-[86%]" />
						</ToolCard>
						<ToolCard tool={DIELINE} index={1}>
							<DielineArt slot="art" class="h-auto w-[86%]" />
						</ToolCard>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Principles (dark tile) -->
	<section class="bg-tile text-on-tile" aria-labelledby="principles-heading">
		<div class="mx-auto max-w-page px-5 py-16 sm:px-8 sm:py-24">
			<div class="max-w-2xl">
				<p class="eyebrow text-on-tile-2">Why VendorDesk</p>
				<h2 id="principles-heading" class="mt-3 text-display text-on-tile">Built the way a utility should be.</h2>
			</div>
			<div class="mt-12 grid gap-10 md:grid-cols-3 md:grid-rows-[repeat(3,auto)] md:gap-x-8 md:gap-y-0">
				{
					principles.map((p) => (
						<div class="border-t border-white/15 pt-6 md:row-span-3 md:grid md:grid-rows-subgrid">
							<p class="tnum text-caption text-on-tile-2">{p.n}</p>
							<h3 class="mt-3 text-title text-on-tile">{p.title}</h3>
							<p class="mt-3 text-body text-on-tile-2">{p.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- How it works -->
	<section class="bg-canvas" aria-labelledby="how-heading">
		<div class="mx-auto max-w-page px-5 py-16 sm:px-8 sm:py-24">
			<div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
				<div>
					<p class="eyebrow">How it works</p>
					<h2 id="how-heading" class="mt-3 text-display text-ink">Three steps, thirty seconds.</h2>
					<p class="mt-4 text-body text-ink-2">No onboarding, no tutorial video. If you can fill in a form, you already know how to use VendorDesk.</p>
				</div>
				<ol class="grid gap-4 sm:grid-cols-3 sm:grid-rows-[repeat(3,auto)] sm:gap-x-4 sm:gap-y-0">
					{
						steps.map((s, i) => (
							<li class="card p-6 sm:row-span-3 sm:grid sm:grid-rows-subgrid">
								<span class="tnum inline-grid size-9 place-items-center justify-self-start rounded-full bg-primary text-caption font-semibold text-on-primary">{i + 1}</span>
								<h3 class="mt-5 text-[1.0625rem] font-semibold text-ink">{s.title}</h3>
								<p class="mt-2 text-caption text-ink-2">{s.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<!-- Audiences -->
	<section class="border-y border-hairline bg-parchment" aria-labelledby="audience-heading">
		<div class="mx-auto max-w-page px-5 py-16 sm:px-8 sm:py-24">
			<div class="max-w-2xl">
				<p class="eyebrow">Made for</p>
				<h2 id="audience-heading" class="mt-3 text-display text-ink">People who ship, bill and print for themselves.</h2>
			</div>
			{/*
			  Five cards laid over a six-column grid: three spanning two columns on the top row,
			  two spanning three on the bottom, so both rows run flush to the edge instead of
			  stranding a quarter-width card on a row of its own. The same reasoning covers the
			  two-column breakpoint, where an odd last card runs the full width. Below `sm` the
			  cards stack, which is what every phone from a 280px fold cover upwards gets.
			  If the list stops being five, the spans below need revisiting.
			*/}
			<ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-6 lg:grid-rows-[repeat(4,auto)]">
				{
					audiences.map((a, i) => (
						<li
							class:list={[
								'card p-6 lg:row-span-2 lg:grid lg:grid-rows-subgrid',
								i < 3 ? 'lg:col-span-2' : 'lg:col-span-3',
								i === audiences.length - 1 && audiences.length % 2 === 1 && 'sm:col-span-2',
							]}
						>
							<h3 class="text-[1.0625rem] font-semibold text-ink">{a.title}</h3>
							{/* The subgrid row gap supplies this spacing at `lg`, so the margin would double it. */}
							<p class="mt-2 text-caption text-ink-2 lg:mt-0">{a.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- FAQ -->
	<section class="bg-canvas" aria-labelledby="faq-heading">
		<div class="mx-auto max-w-prose px-5 py-16 sm:px-8 sm:py-24">
			<p class="eyebrow">FAQ</p>
			<h2 id="faq-heading" class="mt-3 text-title text-ink">Good questions</h2>
			<div class="mt-8">
				<Faq items={faqs} name="home-faq" />
			</div>
		</div>
	</section>

	<!-- Final CTA -->
	<section class="bg-tile text-on-tile">
		<div class="mx-auto flex max-w-page flex-col items-start gap-6 px-5 py-16 sm:px-8 sm:py-20 md:flex-row md:items-center md:justify-between">
			<div class="max-w-xl">
				<h2 class="text-display text-on-tile">Start with the tool you need today.</h2>
				<p class="mt-3 text-body text-on-tile-2">All free, all instant, and none of them will ask you for an email address.</p>
			</div>
			<div class="flex w-full shrink-0 flex-col gap-3 sm:w-auto sm:flex-row">
				<a href={FREIGHT_CLASS.href} class="btn btn-primary">Freight class calculator</a>
				<a href={BOL.href} class="btn border border-white/30 text-on-tile hover:bg-white/10">Bill of lading generator</a>
			</div>
		</div>
	</section>
</Layout>
