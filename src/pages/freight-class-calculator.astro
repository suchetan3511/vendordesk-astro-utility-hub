---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import DensityTable from '../components/DensityTable.astro';
import { BOL, DIM_WEIGHT, FREIGHT_CHART, FREIGHT_CLASS, NMFC_LOOKUP, WHAT_IS_CLASS } from '../lib/site';
import { appId, breadcrumb, faqPage, softwareApplication, webPage } from '../lib/schema';
import { DEFAULT_FREIGHT_INPUT, LEGACY_DENSITY_CHART, NMFC_DENSITY_SCALE } from '../lib/freight';

const tool = FREIGHT_CLASS;
const title = 'Freight Class Calculator — 2025 NMFC Rules';
const description =
	'Calculate LTL freight class free. Enter dimensions and weight for density and the NMFC class on the current 13-subprovision density scale. No sign-up.';

const faqs = [
	{
		question: 'How do I calculate freight class?',
		answer:
			'Multiply your shipment’s length, width and height in inches, divide by 1,728 to get cubic feet, then divide the total weight in pounds by the cubic feet. That gives you density in pounds per cubic foot. Match the density against the NMFC density scale to find your class. On the current scale, densities from 12 up to 15 pounds per cubic foot rate class 85, and 50 pounds per cubic foot or more rates class 50.',
	},
	{
		question: 'What is the difference between freight class and an NMFC code?',
		answer:
			'The NMFC code identifies what you are shipping — a specific commodity listing in the National Motor Freight Classification. The freight class is the rating number, 50 through 500, that determines your cost. Every NMFC code maps to a class, but for density-based commodities the class depends on the density of that particular shipment.',
	},
	{
		question: 'Is a lower freight class cheaper?',
		answer:
			'Yes. Lower classes represent denser, more easily handled freight, and cost less per hundred pounds. Class 50 is the cheapest rating and class 500 the most expensive.',
	},
	{
		question: 'What happens if I use the wrong freight class?',
		answer:
			'The carrier will reweigh and reinspect the shipment, reclassify it, and bill the difference — usually with an additional inspection or reclassification fee. Underclassing to lower a quote does not save money; it produces a corrected invoice weeks later.',
	},
	{
		question: 'How many freight classes are there?',
		answer:
			'Eighteen: 50, 55, 60, 65, 70, 77.5, 85, 92.5, 100, 110, 125, 150, 175, 200, 250, 300, 400 and 500. Only thirteen of them are assigned by density. Classes 77.5, 110, 150, 200 and 500 exist in the NMFC but come from specific commodity listings or from stowability, handling and liability characteristics rather than from the density scale.',
	},
	{
		question: 'Does freight class apply to full truckload shipments?',
		answer:
			'No. Freight class applies to LTL — less-than-truckload — shipments, where multiple customers’ freight shares a trailer and space must be rated fairly. Full truckload pricing is generally negotiated per lane and does not use classification.',
	},
];

const schema = [
	webPage({ name: title, path: tool.href, description, mainEntity: appId(tool.href), hasBreadcrumb: true, market: tool.market }),
	softwareApplication({
		name: tool.name,
		path: tool.href,
		description,
		category: 'BusinessApplication',
		features: tool.features,
		keywords: tool.keywords,
		market: tool.market,
	}),
	faqPage(faqs, tool.href),
	breadcrumb([
		{ name: 'Home', path: '/' },
		{ name: tool.name, path: tool.href },
	]),
];

const dims = [
	['fc-length', 'Length', DEFAULT_FREIGHT_INPUT.length],
	['fc-width', 'Width', DEFAULT_FREIGHT_INPUT.width],
	['fc-height', 'Height', DEFAULT_FREIGHT_INPUT.height],
] as const;
---

<Layout title={title} description={description} schema={schema} lang={tool.market.lang} ogLocale={tool.market.ogLocale}>
	<!-- Hero -->
	<section class="border-b border-hairline bg-canvas">
		<div class="mx-auto max-w-page px-5 pt-8 pb-10 sm:px-8 sm:pt-12 sm:pb-14">
			<Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Tools', href: '/#tools' }, { name: tool.shortName }]} />
			<div class="mt-6 max-w-3xl">
				<p class="eyebrow">LTL shipping · Free · No sign-up</p>
				<h1 class="mt-3 text-display text-ink">Freight Class Calculator</h1>
				<p class="mt-4 text-lead text-ink-2">
					Enter your shipment’s dimensions and weight to get its density and NMFC freight class. Everything is calculated in
					your browser — nothing is uploaded and no account is needed. Results use the current density scale, as restructured by
					the NMFTA in July 2025.
				</p>
			</div>
			<ul class="mt-6 flex flex-wrap gap-2" aria-label="Highlights">
				<li class="chip">Free · no sign-up</li>
				<li class="chip">2025 NMFC density scale</li>
				<li class="chip">Inches or centimetres</li>
				<li class="chip">Multi-pallet</li>
				<li class="chip">Copyable BOL summary</li>
			</ul>
		</div>
	</section>

	<!-- Tool -->
	<section id="tool" class="bg-parchment" aria-labelledby="tool-heading">
		<h2 id="tool-heading" class="sr-only">Freight class and density calculator</h2>
		<div
			class="mx-auto grid max-w-page gap-6 px-5 py-8 sm:px-8 sm:py-12 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:items-start"
			data-freight-tool
		>
			<!-- Inputs -->
			<form class="card p-5 sm:p-6" novalidate autocomplete="off" aria-label="Shipment dimensions and weight">
				<div class="flex items-center justify-between gap-3">
					<h3 class="text-[1.0625rem] font-semibold text-ink">Your shipment</h3>
					<button type="button" class="btn-quiet" data-reset>Reset</button>
				</div>

				{/*
				  `items-center`, not `items-end`: the segmented control is more than twice the
				  label's height, so bottom-aligning the boxes drops the label's text about 12px
				  below the toggle's own text and reads as a sagging label.
				*/}
				<div class="mt-5 flex items-center justify-between gap-4">
					<p class="field-label mb-0">Dimensions (per piece)</p>
					<div class="segmented w-auto" role="group" aria-label="Length units">
						<button type="button" data-length-unit="in" aria-pressed="true">in</button>
						<button type="button" data-length-unit="cm" aria-pressed="false">cm</button>
					</div>
				</div>
				<div class="mt-2 grid grid-cols-3 gap-2 sm:gap-3">
					{
						dims.map(([id, label, value]) => (
							<div>
								<label for={id} class="text-fine font-semibold text-ink-2">
									{label}
								</label>
								<div class="relative mt-1">
									<input id={id} name={id} type="number" inputmode="decimal" min="0.1" step="0.1" value={value} class="field tnum pr-9" required />
									<span class="pointer-events-none absolute inset-y-0 right-3 grid place-items-center text-fine text-ink-3" data-length-label>
										in
									</span>
								</div>
							</div>
						))
					}
				</div>
				<p class="field-hint">
					Measure to the outside of the packaging. If the freight is palletized, include the pallet in the height.
				</p>

				{/*
				  `sm:items-end` keeps the two inputs on one line. The weight column carries a units
				  toggle above its field and the pieces column carries only a label, so the columns
				  are different heights — and in the narrow desktop form "Total weight" wraps, making
				  the gap worse. Bottom-aligning the columns lands both fields on the same baseline
				  whatever the labels do.
				*/}
				<div class="mt-6 grid gap-3 sm:grid-cols-2 sm:items-end">
					<div>
						<div class="flex items-center justify-between gap-2">
							<label for="fc-weight" class="field-label mb-0">Total weight</label>
							<div class="segmented w-auto" role="group" aria-label="Weight units">
								<button type="button" data-weight-unit="lb" aria-pressed="true">lb</button>
								<button type="button" data-weight-unit="kg" aria-pressed="false">kg</button>
							</div>
						</div>
						<div class="relative mt-2">
							<input
								id="fc-weight"
								name="fc-weight"
								type="number"
								inputmode="decimal"
								min="0.1"
								step="0.1"
								value={DEFAULT_FREIGHT_INPUT.weight}
								class="field tnum pr-10"
								required
							/>
							<span class="pointer-events-none absolute inset-y-0 right-3 grid place-items-center text-fine text-ink-3" data-weight-label>
								lb
							</span>
						</div>
					</div>
					<div>
						<label for="fc-pieces" class="field-label">Pieces or pallets</label>
						<input
							id="fc-pieces"
							name="fc-pieces"
							type="number"
							inputmode="numeric"
							min="1"
							step="1"
							value={DEFAULT_FREIGHT_INPUT.pieces}
							class="field tnum mt-2"
							required
						/>
					</div>
				</div>
				<p class="field-hint">
					Weight is the gross weight of the <strong class="font-semibold text-ink">whole shipment</strong>, including packaging and
					pallets — not the weight of one piece.
				</p>

				<p class="field-error" data-error hidden role="alert">Enter a positive number in every field to see a class.</p>

				<p class="mt-5 text-fine text-ink-3">Your figures never leave this device. Nothing is uploaded or stored.</p>
			</form>

			<!-- Result -->
			<div class="grid gap-4 lg:sticky lg:top-20">
				<div class="card p-5 sm:p-6">
					{/* The empty state is the default so that with JavaScript off the panel reads as a
					    prompt rather than a grid of em-dashes. The script swaps them on first render. */}
					<div data-empty>
						<p class="text-body text-ink-2">Enter dimensions and a weight to see your freight class.</p>
						<noscript>
							<p class="mt-3 text-caption text-ink-2">
								The calculator needs JavaScript, but the full density scale and every figure it uses are printed below.
							</p>
						</noscript>
					</div>

					<div data-result hidden>
						<p class="eyebrow">Your freight class</p>
						<div class="mt-3 flex flex-wrap items-end gap-x-5 gap-y-2">
							<p class="tnum text-[clamp(3.5rem,12vw,5.5rem)] leading-[0.9] font-semibold tracking-[-0.03em] text-ink" data-out="class">—</p>
							<p class="text-caption text-ink-2">
								Density <span class="tnum font-semibold text-ink" data-out="density">—</span> lb/ft³<br />
								Sub <span class="tnum font-semibold text-ink" data-out="sub">—</span> · <span class="tnum" data-out="band">—</span> lb/ft³
							</p>
						</div>

						<dl class="tnum mt-6 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-hairline pt-5 text-caption sm:grid-cols-3">
							<div>
								<dt class="text-fine text-ink-2">Cubic feet</dt>
								<dd class="font-semibold text-ink"><span data-out="cubicFeet">—</span> ft³</dd>
							</div>
							<div>
								<dt class="text-fine text-ink-2">Cubic inches</dt>
								<dd class="font-semibold text-ink" data-out="cubicInches">—</dd>
							</div>
							<div>
								<dt class="text-fine text-ink-2">Legacy chart</dt>
								<dd class="font-semibold text-ink">Class <span data-out="legacyClass">—</span></dd>
							</div>
						</dl>

						<!-- Only shown when the current scale and the legacy chart disagree. -->
						<div class="mt-5 rounded-md border border-hairline bg-parchment p-4" data-divergence hidden>
							<p class="text-caption text-ink-2">
								<strong class="font-semibold text-ink">The two scales disagree here.</strong> The legacy 18-class chart that most
								calculators still publish returns class <span class="tnum font-semibold text-ink" data-out="legacyClass">—</span> for
								this density. The current NMFC density provision returns
								<span class="tnum font-semibold text-ink" data-out="class">—</span>.
								<a href="#why-they-differ" class="link">Why they differ</a>.
							</p>
						</div>

						<div class="mt-6 border-t border-hairline pt-5">
							<p class="text-fine font-semibold text-ink-2">Summary for the bill of lading</p>
							<p class="tnum mt-2 rounded-md border border-hairline bg-parchment p-3 text-caption break-words text-ink" data-out="summary">—</p>
							<div class="mt-3 flex flex-wrap items-center gap-2">
								<button type="button" class="btn btn-primary btn-sm" data-copy>Copy summary</button>
								{/* Carries the rated shipment straight onto the document, so the class cannot be mistyped. */}
								<a href={BOL.href} class="btn btn-secondary btn-sm" data-bol-link>Create a bill of lading</a>
								<p class="text-fine text-ink-2" data-status role="status" aria-live="polite"></p>
							</div>
						</div>
					</div>
				</div>

				<p class="text-fine text-ink-3">
					Figures are indicative. Confirm classification with your carrier before booking.
				</p>
			</div>
		</div>
	</section>

	<!-- Editorial -->
	<section class="bg-canvas">
		<div class="mx-auto max-w-prose px-5 py-16 sm:px-8 sm:py-24">
			<div class="rich-text">
				<p class="eyebrow">How it works</p>
				<h2 class="mt-3!">How this calculator works</h2>
				<p class="lede">
					Freight class for most commodities is determined by density — how many pounds your shipment weighs per cubic foot of
					space it occupies. The calculator multiplies your length, width and height to get cubic inches, divides by 1,728 to
					convert to cubic feet, then divides your total weight by that figure. The result is matched against the density scale
					below to return a class between 50 and 500.
				</p>
				<p>
					Measure to the outside of the packaging, not the product. Include the pallet in both the height and the weight if your
					freight is palletized — carriers measure what they actually load, and a 6-inch pallet under a 54-inch stack makes it a
					60-inch shipment. If you want the background rather than the arithmetic, read
					<a href={WHAT_IS_CLASS.href}>how freight class is determined</a>.
				</p>

				<h2 id="density-scale">Density to freight class</h2>
				<p>
					This is the density provision as it stands after the NMFTA’s Docket 2025-1, which took effect on 19 July 2025 and
					expanded the scale from eleven subprovisions to thirteen. The two new subprovisions at the top — 35 to 50, and 50 or
					greater — introduced classes 55 and 50 to the density scale for the first time.
				</p>
			</div>

			<div class="mt-8 grid gap-8 lg:grid-cols-2 lg:gap-10">
				<div>
					<h3 class="text-[1.0625rem] font-semibold text-ink">Current NMFC density scale</h3>
					<p class="mt-1 text-fine text-ink-2">Thirteen subprovisions. What the calculator returns.</p>
					<DensityTable
						class="mt-4"
						bands={NMFC_DENSITY_SCALE}
						showSub
						interactive
						caption="Density in pounds per cubic foot and the freight class it rates, effective 19 July 2025."
					/>
				</div>
				<div>
					<h3 class="text-[1.0625rem] font-semibold text-ink">Legacy 18-class chart</h3>
					<p class="mt-1 text-fine text-ink-2">Still published widely. Shown for comparison.</p>
					<DensityTable
						class="mt-4"
						bands={LEGACY_DENSITY_CHART}
						caption="The older chart that maps all eighteen classes to a density band."
					/>
				</div>
			</div>

			<div class="rich-text mt-12">
				<h2 id="why-they-differ">Why the two scales differ</h2>
				<p>
					The 18-row chart maps every one of the eighteen freight classes to a density band. It is the version almost every
					competing calculator publishes, and it is the version most people have seen. The problem is that the NMFC density
					provision does not work that way. It assigns thirteen classes, and five of the eighteen —
					<strong>77.5, 110, 150, 200 and 500</strong> — are never produced by density at all. They exist in the classification,
					but they come from specific commodity listings, or from the stowability, handling and liability characteristics of the
					goods.
				</p>
				<p>
					The two agree at and above 15 pounds per cubic foot. Below that they drift apart: a shipment at 6.5 pounds per cubic
					foot rates class 125 on the current provision and class 150 on the legacy chart. When your shipment falls in one of
					those bands, the calculator tells you so and shows both numbers, because your carrier may still quote from a rate base
					built on the older structure. That is a conversation to have before you book, not after.
				</p>
				<p>
					For a class-by-class view with example commodities, see the <a href={FREIGHT_CHART.href}>full freight class chart</a>.
				</p>

				<h2>Before you book</h2>
				<p>
					Density decides the class for most freight, but not all of it. Some commodities have a fixed class assigned in the NMFC
					regardless of density, and stowability, handling and liability can override the density result. Check your
					commodity’s NMFC listing or confirm with your carrier before booking — a wrong class on the bill of lading is the
					most common cause of an unexpected reclassification charge. You can
					<a href={NMFC_LOOKUP.href}>look up your NMFC code</a> to see whether your commodity rates on density or carries a fixed
					class.
				</p>
				<p>
					Lower classes are denser freight and cost less per hundredweight to ship. A pallet of bricks is dense, low-class and
					cheap to move; a pallet of ping-pong balls is light, high-class and expensive, because it takes the same trailer space
					for far less weight.
				</p>
				<p class="callout">
					Shipping boxes rather than pallets? Parcel carriers do not use freight class — they price on dimensional weight instead.
					Use the <a href={DIM_WEIGHT.href}>dimensional weight calculator</a> for UPS, FedEx and USPS shipments.
				</p>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="border-t border-hairline bg-parchment">
		<div class="mx-auto max-w-prose px-5 py-16 sm:px-8 sm:py-24">
			<p class="eyebrow">FAQ</p>
			<h2 class="mt-3 text-title text-ink">Freight class questions</h2>
			<div class="mt-8">
				<Faq items={faqs} name="freight-class-faq" />
			</div>
		</div>
	</section>

	<!-- Cross-sell -->
	<section class="bg-tile text-on-tile">
		<div class="mx-auto flex max-w-page flex-col items-start gap-6 px-5 py-16 sm:px-8 sm:py-20 md:flex-row md:items-center md:justify-between">
			<div class="max-w-xl">
				<h2 class="text-title text-on-tile">Shipping parcels as well as pallets?</h2>
				<p class="mt-2 text-body text-on-tile-2">
					Work out dimensional weight and billable weight for UPS, FedEx and USPS — with the whole-inch round-up and the USPS
					one-cubic-foot threshold applied correctly.
				</p>
			</div>
			<a href={DIM_WEIGHT.href} class="btn btn-primary w-full shrink-0 sm:w-auto">Open the DIM weight calculator</a>
		</div>
	</section>
</Layout>

<script>
	import { initFreightClassTool } from '../scripts/freight-class';
	const root = document.querySelector<HTMLElement>('[data-freight-tool]');
	if (root) initFreightClassTool(root);
</script>
