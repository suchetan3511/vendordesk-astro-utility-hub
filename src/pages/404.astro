---
import Layout from '../layouts/Layout.astro';
import { TOOLS } from '../lib/site';
---

<Layout title="Page not found" description="The page you were looking for does not exist." noindex>
	<section class="bg-canvas">
		<div class="mx-auto max-w-page px-5 py-24 sm:px-8 sm:py-32">
			<p class="eyebrow">404</p>
			<h1 class="mt-3 text-display text-ink">That page has been die-cut out of the site.</h1>
			<p class="mt-4 max-w-xl text-lead text-ink-2">The link may be old or mistyped. The tools are still right here.</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row">
				<a href="/" class="btn btn-primary">Back to the homepage</a>
				{TOOLS.map((t) => <a href={t.href} class="btn btn-ghost">{t.shortName}</a>)}
			</div>
		</div>
	</section>
</Layout>
