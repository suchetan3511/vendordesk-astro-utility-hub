---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { TOOLS, SITE } from '../lib/site';
import { breadcrumb, faqPage, softwareApplication, webPage } from '../lib/schema';
import { MATERIALS, PRESETS, STYLES, DEFAULT_INPUT } from '../scripts/dieline';

const tool = TOOLS[0];
const title = 'Paper Bag Die-Line Generator — Free SVG Template Maker';
const description =
	'Generate a print-ready paper bag die-line in seconds: enter height, width and gusset, pick luxury or rustic folds and your material (even grain-lined kraft), then download the SVG or PNG. Free, no sign-up.';

const faqs = [
	{
		question: 'Is the downloaded SVG at real-world scale?',
		answer:
			'Yes. The SVG declares its width and height in millimetres and uses a millimetre viewBox, so Illustrator, Affinity Designer, CorelDRAW and Inkscape open it at 1:1. Nothing needs to be rescaled before you send it to a die-maker.',
	},
	{
		question: 'What is the difference between a luxury fold and a rustic fold?',
		answer:
			'A <strong>luxury fold</strong> uses a deeper 40 mm turned-over top hem (to hide a reinforcing card and anchor rope handles), a 25 mm base overlap for a stiff, square bottom, and eyelet marks. A <strong>rustic fold</strong> uses a slimmer 25 mm turnover, an 18 mm base overlap and glue-patch marks for twisted paper handles — less material, faster to convert.',
	},
	{
		question: 'Why does the bajra/jau lining change the bleed and sheet size?',
		answer:
			'A grain lining laminated to the kraft outer roughly quadruples the caliper. Thicker stock consumes more paper at every fold and wraps printed artwork further around each crease, so the generator adds fold allowance to the sheet and increases the structural bleed for the sticker or print layout.',
	},
	{
		question: 'Are my dimensions or artwork uploaded anywhere?',
		answer:
			'No. The geometry, the SVG and the PNG are all generated by JavaScript running in your browser. VendorDesk has no server that receives your inputs; your last settings are only remembered in your own browser storage so you can pick up where you left off.',
	},
	{
		question: 'Can I use this die-line directly for production tooling?',
		answer:
			'Use it as a precise starting point. Every converter’s creasing rules, board and glue system differ slightly, so always proof a physical mock-up and confirm allowances with your die-maker before ordering a cutting die.',
	},
];

const schema = [
	webPage({ name: title, path: tool.href, description }),
	softwareApplication({
		name: tool.name,
		path: tool.href,
		description,
		category: 'DesignApplication',
		features: [
			'Height, width and gusset inputs in millimetres or inches',
			'Luxury and rustic fold styles',
			'Material thickness compensation including grain-lined kraft',
			'Structural bleed calculation',
			'Seamless sticker blend layout lines',
			'Real-scale SVG and PNG download',
			'Parent sheet yield estimate',
		],
		keywords: tool.keywords,
	}),
	faqPage(faqs, tool.href),
	breadcrumb([
		{ name: 'Home', path: '/' },
		{ name: tool.name, path: tool.href },
	]),
];
---

<Layout title={title} description={description} schema={schema}>
	<!-- Page hero -->
	<section class="border-b border-hairline bg-canvas">
		<div class="mx-auto max-w-page px-5 pt-8 pb-10 sm:px-8 sm:pt-12 sm:pb-14">
			<Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Tools', href: '/#tools' }, { name: tool.shortName }]} />
			<div class="mt-6 max-w-3xl">
				<p class="eyebrow">Packaging · Free · No sign-up</p>
				<h1 class="mt-3 text-display text-ink">Paper Bag Die-Line Generator</h1>
				<p class="mt-4 text-lead text-ink-2">
					Enter the bag’s height, width and gusset. Get a print-ready, real-scale SVG die-line with fold lines, material-aware
					bleed and seamless sticker layout guides — instantly, in your browser.
				</p>
			</div>
			<ul class="mt-6 flex flex-wrap gap-2" aria-label="Highlights">
				<li class="chip">1:1 mm scale SVG</li>
				<li class="chip">PNG export</li>
				<li class="chip">Luxury &amp; rustic folds</li>
				<li class="chip">Grain-lining thickness</li>
				<li class="chip">Nothing uploaded</li>
			</ul>
		</div>
	</section>

	<!-- Tool -->
	<section id="tool" class="bg-parchment" aria-labelledby="tool-heading">
		<h2 id="tool-heading" class="sr-only">Die-line calculator</h2>
		<div
			class="mx-auto grid max-w-page gap-6 px-5 py-8 sm:px-8 sm:py-12 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:items-start"
			data-dieline-tool
		>
			<!-- Controls -->
			<form class="card p-5 sm:p-6" novalidate autocomplete="off" aria-label="Bag dimensions">
				<div class="flex items-center justify-between gap-3">
					<h3 class="text-[1.0625rem] font-semibold">Bag specification</h3>
					<button type="button" id="reset-tool" class="text-caption text-ink-2 underline decoration-hairline-strong underline-offset-4 hover:text-ink">Reset</button>
				</div>

				<!-- Live result strip (mobile sees numbers change instantly) -->
				<dl class="tnum mt-4 grid grid-cols-2 gap-3 rounded-md border border-hairline bg-parchment p-3.5 text-caption">
					<div>
						<dt class="text-fine text-ink-2">Flat sheet</dt>
						<dd class="text-[1.0625rem] font-semibold text-ink"><span data-out="flatW">—</span> × <span data-out="flatH">—</span></dd>
					</div>
					<div>
						<dt class="text-fine text-ink-2">Sheet area</dt>
						<dd class="text-[1.0625rem] font-semibold text-ink"><span data-out="areaIn">—</span></dd>
					</div>
				</dl>

				<fieldset class="mt-6">
					<legend class="field-label">Quick presets</legend>
					<div class="grid grid-cols-3 gap-2">
						{
							PRESETS.map((p) => (
								<button type="button" data-preset={p.id} class="option-card min-h-16 items-start justify-center px-3 py-2.5" aria-pressed="false" title={p.hint}>
									<span class="text-caption font-semibold text-ink">{p.label}</span>
									<span class="text-fine text-ink-3">{p.hint.split(' · ')[0]}</span>
								</button>
							))
						}
					</div>
				</fieldset>

				<div class="mt-6 flex items-end justify-between gap-4">
					<p class="field-label mb-0">Dimensions</p>
					<div class="segmented w-auto" role="group" aria-label="Units">
						<button type="button" data-unit="mm" aria-pressed="true">mm</button>
						<button type="button" data-unit="in" aria-pressed="false">inches</button>
					</div>
				</div>
				<div class="mt-2 grid grid-cols-3 gap-2 sm:gap-3">
					{
						[
							['height', 'Height', DEFAULT_INPUT.height],
							['width', 'Width', DEFAULT_INPUT.width],
							['gusset', 'Gusset', DEFAULT_INPUT.gusset],
						].map(([id, label, value]) => (
							<div>
								<label for={String(id)} class="text-fine font-semibold text-ink-2">
									{label}
								</label>
								<div class="relative mt-1">
									<input id={String(id)} name={String(id)} type="number" inputmode="decimal" value={value} class="field tnum pr-9" required />
									<span class="pointer-events-none absolute inset-y-0 right-3 grid place-items-center text-fine text-ink-3" data-unit-label>
										mm
									</span>
								</div>
							</div>
						))
					}
				</div>
				<p id="form-error" class="field-error" hidden role="alert"></p>
				<p class="field-hint">Height is the front panel, width is the bag opening, gusset is the side depth when the bag is opened.</p>

				<fieldset class="mt-6">
					<legend class="field-label">Fold style</legend>
					<div class="grid gap-2 sm:grid-cols-2">
						{
							(Object.keys(STYLES) as Array<keyof typeof STYLES>).map((key) => (
								<button type="button" data-style={key} class="option-card" aria-pressed={String(key === DEFAULT_INPUT.style)}>
									<span class="text-caption font-semibold text-ink">{STYLES[key].label}</span>
									<span class="text-fine text-ink-2">{STYLES[key].tagline}</span>
								</button>
							))
						}
					</div>
				</fieldset>

				<div class="mt-6">
					<label for="material" class="field-label">Material</label>
					<select id="material" name="material" class="field">
						{
							MATERIALS.map((m) => (
								<option value={m.id} selected={m.id === DEFAULT_INPUT.materialId}>
									{m.label} — {m.gsm} · {m.thickness} mm
								</option>
							))
						}
					</select>
					<p class="field-hint" data-out="materialNote"></p>
				</div>

				<details class="group mt-6 rounded-md border border-hairline bg-parchment">
					<summary class="flex min-h-11 cursor-pointer items-center justify-between px-4 text-caption font-semibold text-ink">
						Advanced: glue flap, bleed &amp; overlays
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-open:rotate-180"><path d="M6 9l6 6 6-6"></path></svg>
					</summary>
					<div class="grid gap-4 border-t border-hairline px-4 py-4">
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label for="glue" class="text-fine font-semibold text-ink-2">Glue flap (mm)</label>
								<input id="glue" type="number" inputmode="decimal" min="8" max="60" step="1" value={DEFAULT_INPUT.glueFlap} class="field tnum mt-1" />
							</div>
							<div>
								<label for="bleed" class="text-fine font-semibold text-ink-2">Base bleed (mm)</label>
								<input id="bleed" type="number" inputmode="decimal" min="0" max="10" step="0.5" value={DEFAULT_INPUT.baseBleed} class="field tnum mt-1" />
							</div>
						</div>
						<div class="grid gap-2.5">
							<label class="flex min-h-11 items-center gap-3 text-caption text-ink">
								<input id="show-sticker" type="checkbox" checked class="size-5 accent-primary" />
								Show seamless sticker blend layout lines
							</label>
							<label class="flex min-h-11 items-center gap-3 text-caption text-ink">
								<input id="show-handles" type="checkbox" checked class="size-5 accent-primary" />
								Show handle marks (eyelets or glue patches)
							</label>
							<label class="flex min-h-11 items-center gap-3 text-caption text-ink">
								<input id="show-labels" type="checkbox" checked class="size-5 accent-primary" />
								Show labels and dimension lines
							</label>
						</div>
					</div>
				</details>

				<p class="mt-5 text-fine text-ink-3">
					Your inputs never leave this device. Settings are remembered in your browser only.
				</p>
			</form>

			<!-- Preview -->
			<div class="grid gap-4 lg:sticky lg:top-20">
				<div class="card overflow-hidden">
					<div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-4 py-3 sm:px-5">
						<h3 class="text-[1.0625rem] font-semibold">Die-line preview</h3>
						<ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-fine text-ink-2" aria-label="Legend">
							<li class="flex items-center gap-1.5"><span class="h-0.5 w-4 rounded bg-cut"></span>Cut</li>
							<li class="flex items-center gap-1.5"><span class="h-0.5 w-4 rounded border-t-2 border-dashed border-fold"></span>Fold</li>
							<li class="flex items-center gap-1.5"><span class="h-0.5 w-4 rounded border-t-2 border-dashed border-bleed"></span>Bleed</li>
							<li class="flex items-center gap-1.5"><span class="h-0.5 w-4 rounded bg-sticker"></span>Sticker</li>
						</ul>
					</div>
					<div class="bg-paper p-4 sm:p-6">
						<div id="preview" class="mx-auto max-w-[900px] [&>svg]:h-auto [&>svg]:w-full [&>svg]:max-h-[70vh]">
							<div class="grid aspect-[4/3] place-items-center text-caption text-ink-3">Enable JavaScript to render the die-line.</div>
						</div>
					</div>
					<div class="flex flex-wrap items-center gap-2 border-t border-hairline px-4 py-3 sm:px-5">
						<button type="button" id="download-svg" class="btn btn-primary btn-sm">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14"></path></svg>
							Download SVG
						</button>
						<button type="button" id="download-png" class="btn btn-ghost btn-sm">Download PNG</button>
						<button type="button" id="copy-summary" class="btn btn-ghost btn-sm">Copy summary</button>
						<p id="tool-status" class="ml-auto text-fine text-ink-2" role="status" aria-live="polite"></p>
					</div>
				</div>

				<!-- Dynamic summary -->
				<div class="card p-5 sm:p-6">
					<p class="eyebrow">Live specification</p>
					<p id="dynamic-primary" class="mt-3 text-body font-semibold text-ink"></p>
					<p id="dynamic-secondary" class="mt-3 text-caption text-ink-2"></p>

					<dl class="tnum mt-5 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-hairline pt-5 text-caption sm:grid-cols-4">
						<div><dt class="text-fine text-ink-2">Structural bleed</dt><dd class="font-semibold text-ink" data-out="bleed">—</dd></div>
						<div><dt class="text-fine text-ink-2">Caliper</dt><dd class="font-semibold text-ink" data-out="thickness">—</dd></div>
						<div><dt class="text-fine text-ink-2">Fold allowance</dt><dd class="font-semibold text-ink" data-out="foldAllow">—</dd></div>
						<div><dt class="text-fine text-ink-2">Glue flap</dt><dd class="font-semibold text-ink" data-out="glue">—</dd></div>
						<div><dt class="text-fine text-ink-2">Top hem</dt><dd class="font-semibold text-ink" data-out="topHem">—</dd></div>
						<div><dt class="text-fine text-ink-2">Base fold zone</dt><dd class="font-semibold text-ink" data-out="baseZone">—</dd></div>
						<div><dt class="text-fine text-ink-2">Yield · 25 × 36 in</dt><dd class="font-semibold text-ink" data-out="yield1">—</dd></div>
						<div><dt class="text-fine text-ink-2">Yield · 700 × 1000 mm</dt><dd class="font-semibold text-ink" data-out="yield2">—</dd></div>
					</dl>
				</div>
			</div>
		</div>
	</section>

	<!-- Editorial content -->
	<section class="bg-canvas">
		<div class="mx-auto max-w-prose px-5 py-16 sm:px-8 sm:py-24">
			<div class="rich-text">
				<p class="eyebrow">How it works</p>
				<h2 class="mt-3!">How the die-line is calculated</h2>
				<p class="lede">
					A gusseted paper bag is a single flat sheet folded into five vertical panels — front, gusset, back, gusset and a glue
					flap — with a turned-over hem on top and a fold zone at the base. The generator lays those panels out edge to edge
					and then compensates for the paper you chose.
				</p>
				<ul>
					<li><strong>Flat sheet width</strong> = 2 × width + 2 × gusset + glue flap + fold allowance.</li>
					<li><strong>Flat sheet height</strong> = height + top hem + base fold zone (½ gusset + overlap) + fold allowance.</li>
					<li><strong>Fold allowance</strong> = 7 vertical folds × 1.5 × material caliper. The outer skin of the paper travels further than the inner skin at every crease, so thick or laminated stock needs more sheet.</li>
					<li><strong>Structural bleed</strong> = base bleed (3 mm by default) + 4 × caliper. Printed artwork and full-wrap stickers must run out this far past every edge and fold.</li>
					<li><strong>Sheet area</strong> is reported in square inches and square centimetres so you can price stock and estimate yield from a 25 × 36 in or 700 × 1000 mm parent sheet.</li>
				</ul>

				<h2>Luxury fold vs. rustic fold</h2>
				<p>
					The fold style changes the three areas that are not visible on the finished bag but decide how it feels in the hand:
					the top hem, the base overlap and the handle attachment.
				</p>
				<div class="table-wrap">
					<table>
						<thead>
							<tr><th>Feature</th><th>Luxury fold</th><th>Rustic fold</th></tr>
						</thead>
						<tbody>
							<tr><td>Top hem / turnover</td><td>40 mm — hides a card stiffener and anchors rope, ribbon or die-cut handles</td><td>25 mm — a slim turnover for twisted paper handles</td></tr>
							<tr><td>Base overlap</td><td>25 mm — square, rigid bottom that takes a card insert</td><td>18 mm — economical, quick to convert</td></tr>
							<tr><td>Handle marks</td><td>Four 6 mm eyelet positions at ¼ and ¾ of the panel width</td><td>Two glue patches per panel for twisted handles</td></tr>
							<tr><td>Best for</td><td>Boutiques, gifting, premium retail</td><td>Bakeries, groceries, grain and flour bags</td></tr>
						</tbody>
					</table>
				</div>

				<h2>Why material thickness changes your die-line</h2>
				<p>
					Most online template makers treat paper as a zero-thickness line. Real stock is not. A 90 gsm kraft sheet is around
					0.13 mm thick; coated art paper around 0.17 mm; card stock 0.3 mm. A kraft outer laminated with a food-safe
					<strong>bajra or jau grain lining</strong> — common for millet, flour and grain retail bags — is closer to 0.55 mm.
					Four times the caliper means four times the material consumed at every crease, and a print that stops exactly at a
					fold line will show a white sliver once the bag is formed.
				</p>
				<p>
					Pick the material and the generator widens each panel by the fold allowance, deepens the hem and base zone, and grows
					the structural bleed so your sticker or print artwork wraps cleanly around every fold.
				</p>

				<h2>Seamless sticker blend layout, explained</h2>
				<p>
					Short-run bags are often decorated with a single full-wrap sticker rather than a printed sheet. The amber band on the
					preview marks that sticker: it runs across front, gusset, back and gusset, extends past the top hem fold and the base
					fold by the structural bleed, and overlaps onto the glue flap by a seam allowance so the join lands on the corner
					where the flap tucks under the front panel.
				</p>
				<p>
					The lightly shaded strips centred on every vertical fold are <strong>blend zones</strong>. Keep small type, logos and
					hard edges out of them and let colour or texture continue through — this is what makes the sticker read as seamless
					once the bag is opened out.
				</p>

				<h2>Preparing the SVG for print</h2>
				<ol>
					<li><strong>Import at 1:1.</strong> The file is authored in millimetres; do not scale it to fit an artboard.</li>
					<li><strong>Use the layers.</strong> Cut, fold, crease, bleed, sticker and label groups have their own IDs, so you can assign spot colours such as <code>CutContour</code> and <code>Crease</code> in one click.</li>
					<li><strong>Delete the label layer before tooling.</strong> Labels and dimension lines are for proofing, not for the die.</li>
					<li><strong>Proof a mock-up.</strong> Print the PNG at 100 %, cut, fold and glue it. Check the handle positions and that the base squares off.</li>
					<li><strong>Confirm with your die-maker.</strong> Creasing rules and glue systems vary by converter; the generator’s allowances are a robust default, not a substitute for their spec sheet.</li>
				</ol>

				<h2>Common paper bag sizes (W × H × G)</h2>
				<div class="table-wrap">
					<table>
						<thead>
							<tr><th>Use</th><th>Millimetres</th><th>Inches (approx.)</th></tr>
						</thead>
						<tbody>
							<tr><td>Small boutique / jewellery</td><td>180 × 230 × 80</td><td>7 × 9 × 3</td></tr>
							<tr><td>Medium retail carry</td><td>250 × 350 × 100</td><td>10 × 14 × 4</td></tr>
							<tr><td>Large apparel</td><td>320 × 420 × 120</td><td>12.5 × 16.5 × 4.75</td></tr>
							<tr><td>Wine bottle</td><td>120 × 380 × 90</td><td>4.75 × 15 × 3.5</td></tr>
							<tr><td>Bakery / bread</td><td>200 × 280 × 90</td><td>8 × 11 × 3.5</td></tr>
							<tr><td>Flour / grain 2 kg</td><td>180 × 340 × 100</td><td>7 × 13.5 × 4</td></tr>
						</tbody>
					</table>
				</div>
				<p class="callout">
					Estimates only. VendorDesk is not responsible for manufacturing misprints — always validate a physical sample before
					committing to tooling or a print run. See our <a href="/terms-of-service">terms of service</a>.
				</p>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="border-t border-hairline bg-parchment">
		<div class="mx-auto max-w-prose px-5 py-16 sm:px-8 sm:py-24">
			<p class="eyebrow">FAQ</p>
			<h2 class="mt-3 text-title">Questions designers ask</h2>
			<div class="mt-8">
				<Faq items={faqs} name="dieline-faq" />
			</div>
		</div>
	</section>

	<!-- Cross-sell -->
	<section class="bg-tile text-on-tile">
		<div class="mx-auto flex max-w-page flex-col items-start gap-6 px-5 py-16 sm:px-8 sm:py-20 md:flex-row md:items-center md:justify-between">
			<div class="max-w-xl">
				<h2 class="text-title text-on-tile">Need to bill for the bags too?</h2>
				<p class="mt-2 text-body text-on-tile-2">
					Generate a GST-compliant Bill of Supply for unregistered vendors and composition dealers — as a PDF, in your browser.
				</p>
			</div>
			<a href={TOOLS[1].href} class="btn btn-primary shrink-0">Open the Bill of Supply generator</a>
		</div>
	</section>
</Layout>

<script>
	import { initDielineTool } from '../scripts/dieline';
	const root = document.querySelector<HTMLElement>('[data-dieline-tool]');
	if (root) initDielineTool(root);
</script>
